# Frontend -> backend API base URL.
# Default (no file / empty): http://localhost:3000
# For a deployed backend, set the full URL, e.g.:
#   VITE_API_URL=https://api.allert.my.id
VITE_API_URL=

# Frontend -> backend WebSocket base URL.
# Default (empty): derived from VITE_API_URL (http -> ws, https -> wss).
# Set explicitly when the WS host differs, e.g.:
#   VITE_WS_URL=wss://api.allert.my.id
VITE_WS_URL=
